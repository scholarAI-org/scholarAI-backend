DATABASE_URL=postgresql://postgres:password@localhost:5432/scholarai_db
SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Resend email delivery
RESEND_API_KEY=re_your_api_key
# Use onboarding@resend.dev only for Resend's restricted testing flow.
# Use an address on your verified domain for real application recipients.
RESEND_FROM_EMAIL=onboarding@resend.dev
MAIL_FROM_NAME=Scholar AI Support

# Optional OTP policy overrides
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_OTP_EXPIRE_MINUTES=10
EMAIL_VERIFICATION_OTP_RESEND_COOLDOWN_SECONDS=60

# Private S3-compatible document storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=scholarai-documents
# Optional. Set for MinIO or LocalStack. Leave empty for AWS S3.
AWS_S3_ENDPOINT_URL=
S3_PRESIGN_PUT_EXPIRE_SECONDS=300
S3_PRESIGN_GET_EXPIRE_SECONDS=120
S3_MAX_FILE_BYTES=10485760
S3_MAX_AVATAR_BYTES=5242880
S3_MAX_RECOMMENDATION_LETTERS=3
